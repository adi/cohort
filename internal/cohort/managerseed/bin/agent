#!/usr/bin/env python3
"""Operate on individual cohort agents.

usage: agent list                  every agent: shown/hidden, state, team, purpose
       agent show <name>...        link the agents into Desktop
       agent hide <name>...        unlink the agents from Desktop

Agents live in ~/.cohort/config.json; team and purpose come from
../teams.json; state (working / input / idle) from cohort's tmux server.
"""
import json, os, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
TEAMS = os.path.join(HERE, "..", "teams.json")
CONFIG = os.path.expanduser("~/.cohort/config.json")
STATUS = os.path.expanduser("~/.cohort/status.json")
SETTLE = float(os.environ.get("TEAM_SETTLE", "2.5"))  # seconds for cohort to apply

def load(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        if default is None:
            raise
        return default

def states():
    """Agent name -> @cohort_state, from the Background session."""
    try:
        out = subprocess.run(
            ["tmux", "-L", "cohort", "list-windows", "-t", "=Background",
             "-F", "#{window_name}\t#{@cohort_state}"],
            capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return dict(line.split("\t", 1) for line in out.splitlines() if "\t" in line)

def main():
    args = sys.argv[1:] or ["list"]
    cfg = load(CONFIG)
    agents = cfg.get("agents", [])
    if args == ["list"]:
        teams = load(TEAMS, {}).get("agents", {})
        st = states()
        if not agents:
            print("no agents (config.json has none)")
        w = max([len(a["name"]) for a in agents] + [4])
        for a in agents:
            n = a["name"]
            t = teams.get(n, {})
            print(f"  {n:{w}}  {'shown' if a.get('linked') else 'hidden':6}  "
                  f"{st.get(n) or '-':7}  {t.get('team', '-'):12}  {t.get('purpose', '')}".rstrip())
        return
    if len(args) < 2 or args[0] not in ("show", "hide"):
        sys.exit(__doc__)
    want = args[0] == "show"
    names = args[1:]
    present = {a["name"] for a in agents}
    unknown = [n for n in names if n not in present]
    if unknown:
        sys.exit(f"unknown agent(s): {', '.join(unknown)}; known: {', '.join(sorted(present)) or 'none'}")
    changed = []
    for a in agents:
        if a["name"] in names and a.get("linked", False) != want:
            a["linked"] = want
            changed.append(a["name"])
    if changed:
        tmp = CONFIG + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        os.replace(tmp, CONFIG)
        time.sleep(SETTLE)
    print(f"{'shown' if want else 'hidden'}: {', '.join(changed) or '(no change)'}")
    try:
        issues = load(STATUS).get("issues", {})
    except FileNotFoundError:
        print("status: unknown (no status.json; is cohort running?)")
        return
    print("status: ok" if not issues else f"status issues: {json.dumps(issues)}")

main()
